generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            Int           @id @default(autoincrement())
  username      String        @unique
  email         String        @unique
  passwordHash  String        @map("password_hash")
  fullName      String        @map("full_name")
  role          String        @default("viewer")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")

  projects      Project[]     @relation("ProjectCreator")
  plans         Plan[]        @relation("PlanCreator")
  planVersions  PlanVersion[] @relation("PlanVersionCreator")
  reports       Report[]      @relation("ReportCreator")
  documents     Document[]    @relation("DocumentUploader")
  activityLogs  ActivityLog[] @relation("UserActivityLogs")

  @@map("users")
}

model Project {
  id          Int           @id @default(autoincrement())
  projectCode String        @unique @map("project_code")
  name        String
  description String?
  clientName  String?       @map("client_name")
  location    String?
  startDate   DateTime?     @map("start_date")
  endDate     DateTime?     @map("end_date")
  status      String        @default("planning")
  budget      Float?
  createdBy   Int?          @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")

  creator     User?         @relation("ProjectCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  plans       Plan[]
  reports     Report[]
  documents   Document[]

  @@map("projects")
}

model Plan {
  id          Int          @id @default(autoincrement())
  planCode    String       @unique @map("plan_code")
  title       String
  description String?
  projectId   Int          @map("project_id")
  planType    String       @default("structural") @map("plan_type")
  scale       String?
  format      String       @default("A3")
  status      String       @default("draft")
  createdBy   Int?         @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator     User?        @relation("PlanCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  versions    PlanVersion[]

  @@map("plans")
}

model PlanVersion {
  id               Int      @id @default(autoincrement())
  planId           Int      @map("plan_id")
  versionNumber    String   @map("version_number")
  filePath         String   @map("file_path")
  fileName         String   @map("file_name")
  fileSize         Int?     @map("file_size")
  changeDescription String? @map("change_description")
  createdBy        Int?     @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")

  plan             Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  creator          User?    @relation("PlanVersionCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("plan_versions")
}

model Report {
  id         Int          @id @default(autoincrement())
  reportCode String       @unique @map("report_code")
  title      String
  content    String?
  projectId  Int?         @map("project_id")
  reportType String       @default("technical") @map("report_type")
  status     String       @default("draft")
  createdBy  Int?         @map("created_by")
  createdAt  DateTime     @default(now()) @map("created_at")

  project    Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator    User?        @relation("ReportCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("reports")
}

model Document {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?
  projectId    Int?         @map("project_id")
  documentType String       @default("other") @map("document_type")
  filePath     String       @map("file_path")
  fileName     String       @map("file_name")
  fileSize     Int?         @map("file_size")
  uploadedBy   Int?         @map("uploaded_by")
  uploadedAt   DateTime     @default(now()) @map("uploaded_at")

  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader     User?        @relation("DocumentUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@map("documents")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  actionType  String   @map("action_type")
  entityType  String   @map("entity_type")
  entityId    Int?     @map("entity_id")
  description String?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User?    @relation("UserActivityLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}
